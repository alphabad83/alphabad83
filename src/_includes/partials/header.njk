<header class="site-header">
  <div class="wrap site-header__inner">
    <a href="/" class="brand">
        <span class="brand__mark" aria-hidden="true">
     {% if club.logo %}
       <img src="{{ club.logo }}" alt="" width="34" height="34" style="object-fit:contain">
     {% else %}
       <svg viewBox="0 0 40 40" width="34" height="34">
         <circle cx="20" cy="20" r="19" fill="none" stroke="currentColor" stroke-width="1.5"/>
         <path d="M9 27 L28 9" stroke="currentColor" stroke-width="1.5" fill="none"/>
         <circle cx="28" cy="9" r="3" fill="currentColor"/>
       </svg>
     {% endif %}
   </span>
      <span class="brand__text">
        <span class="brand__name">Alphabad<span class="brand__accent">83</span></span>
        <span class="brand__sub">Canton de Fayence</span>
      </span>
    </a>

    <button class="nav-toggle" aria-expanded="false" aria-controls="nav-principale">
      <span></span><span></span><span></span>
      <span class="sr-only">Ouvrir le menu</span>
    </button>

    <nav id="nav-principale" class="site-nav">
      <a href="/le-club/">Le club</a>
      <a href="/creneaux-tarifs/">Créneaux &amp; tarifs</a>
      <a href="/boutique/">Boutique</a>
      <a href="/actualites/">Actualités</a>
      <a href="/tournois/">Tournois</a>
      <a href="/equipes/">Équipes</a>
      <a href="/contact/" class="site-nav__cta">Nous rejoindre</a>
      <a href="/panier/" class="cart-link" aria-label="Voir le panier">
        🛒 <span data-cart-count class="cart-badge"></span>
      </a>
    </nav>
  </div>
</header>
